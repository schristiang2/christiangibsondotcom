{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/golfmonkey",
      "destination": "/golfmonkey/index.html"
    },
    {
      "source": "/blog/proloded",
      "destination": "/blog/proloded/index.html"
    },
    {
      "source": "/((?!api/|projectsmashburger|golfmonkey|blog/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/projectsmashburger/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
