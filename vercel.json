{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/golfmonkey",
      "destination": "/golfmonkey/index.html"
    },
    {
      "source": "/golfmonkey2",
      "destination": "/golfmonkey2/index.html"
    },
    {
      "source": "/golfmonkeyredesign",
      "destination": "/golfmonkeyredesign/index.html"
    },
    {
      "source": "/gmdashboard",
      "destination": "/gmdashboard/index.html"
    },
    {
      "source": "/blog/proloded",
      "destination": "/blog/proloded/index.html"
    },
    {
      "source": "/albumrank",
      "destination": "/albumrank/index.html"
    },
    {
      "source": "/((?!api/|projectsmashburger|golfmonkey|gmdashboard|blog/|albumrank).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/gmdashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/golfmonkeyredesign/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/projectsmashburger/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
